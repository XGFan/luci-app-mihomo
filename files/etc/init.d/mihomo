#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

EXTRA_COMMANDS="update"
EXTRA_HELP="	update [VERSION]   Download/update the mihomo binary into data_dir"

INSTALL_BINARY=/usr/sbin/mihomo-install-binary

update() {
	if [ ! -x "${INSTALL_BINARY}" ]; then
		echo "mihomo: install helper missing at ${INSTALL_BINARY}" >&2
		return 1
	fi
	"${INSTALL_BINARY}" "$@"
}

ensure_binary() {
	local data_dir="$1"

	if [ -x "${data_dir}/mihomo" ]; then
		return 0
	fi

	echo "mihomo: binary missing at ${data_dir}/mihomo — attempting auto-install"
	if [ ! -x "${INSTALL_BINARY}" ]; then
		echo "mihomo: install helper not found at ${INSTALL_BINARY}" >&2
		return 1
	fi

	if ! "${INSTALL_BINARY}"; then
		echo "mihomo: auto-install failed (run '${INSTALL_BINARY}' manually for diagnostics)" >&2
		return 1
	fi

	[ -x "${data_dir}/mihomo" ]
}

start_service() {
	. /lib/functions.sh
	config_load 'mihomo'

	local enabled data_dir controller_port ui_path secret
	config_get_bool enabled 'main' 'enabled' 1
	config_get data_dir 'main' 'data_dir' '/etc/mihomo'
	config_get controller_port 'main' 'controller_port' '9090'
	config_get ui_path 'main' 'ui_path' 'ui'
	config_get secret 'main' 'secret' ''

	[ "${enabled}" = '1' ] || return 1

	if ! ensure_binary "${data_dir}"; then
		echo "mihomo: cannot start without binary at ${data_dir}/mihomo" >&2
		return 1
	fi

	if [ ! -f "${data_dir}/config.yaml" ]; then
		echo "mihomo: config.yaml missing at ${data_dir}/config.yaml" >&2
		return 1
	fi

	procd_open_instance mihomo
	# Run mihomo directly against the user's config.yaml so the dashboard's
	# "reload config" / "restart core" actions (which re-read mihomo's own -f
	# file) pick up edits. UCI controller/UI/secret are injected as override
	# flags (-ext-ctl/-ext-ui/-secret); they take precedence over the same keys
	# in config.yaml and persist across hot reloads. No ephemeral copy is made,
	# so the user's config.yaml is still never modified.
	procd_set_param command "${data_dir}/mihomo" -d "${data_dir}" -f "${data_dir}/config.yaml" \
		-ext-ctl "0.0.0.0:${controller_port}" -ext-ui "${ui_path}" -secret "${secret}"
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param limits core="unlimited"
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param user root
	procd_set_param pidfile /var/run/mihomo.pid
	# Watch ONLY the UCI file: changing wrapper settings (port/path/secret/…)
	# must restart mihomo to re-apply the override flags. The user's config.yaml
	# is intentionally NOT watched — a bad edit or subscription update must not
	# auto-restart a running mihomo into a failed-to-start state. config.yaml
	# changes apply on the next explicit dashboard "reload config" / "restart
	# core" (or `/etc/init.d/mihomo restart`), when the user is present to react.
	procd_set_param file /etc/config/mihomo
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 'mihomo'
}
