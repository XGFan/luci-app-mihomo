#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

EXTRA_COMMANDS="update"
EXTRA_HELP="	update [VERSION]   Download/update the mihomo binary into data_dir"

RUNTIME_CONFIG=/var/run/mihomo.yaml
INSTALL_BINARY=/usr/sbin/mihomo-install-binary

update() {
	if [ ! -x "${INSTALL_BINARY}" ]; then
		echo "mihomo: install helper missing at ${INSTALL_BINARY}" >&2
		return 1
	fi
	"${INSTALL_BINARY}" "$@"
}

generate_runtime_config() {
	local data_dir="$1"
	local controller_port="$2"
	local ui_path="$3"
	local secret="$4"
	local user_config="${data_dir}/config.yaml"

	mkdir -p /var/run

	# UCI fields override yaml top-level external-controller / external-ui / secret
	{
		printf 'external-controller: "0.0.0.0:%s"\n' "${controller_port}"
		printf 'external-ui: "%s"\n' "${ui_path}"
		printf 'secret: "%s"\n' "${secret}"
		if [ -f "${user_config}" ]; then
			sed -E '/^external-controller:[[:space:]]/d; /^external-ui:[[:space:]]/d; /^secret:[[:space:]]/d' "${user_config}"
		fi
	} > "${RUNTIME_CONFIG}"
}

ensure_binary() {
	local data_dir="$1"

	if [ -x "${data_dir}/mihomo" ]; then
		return 0
	fi

	echo "mihomo: binary missing at ${data_dir}/mihomo — attempting auto-install"
	if [ ! -x "${INSTALL_BINARY}" ]; then
		echo "mihomo: install helper not found at ${INSTALL_BINARY}" >&2
		return 1
	fi

	if ! "${INSTALL_BINARY}"; then
		echo "mihomo: auto-install failed (run '${INSTALL_BINARY}' manually for diagnostics)" >&2
		return 1
	fi

	[ -x "${data_dir}/mihomo" ]
}

start_service() {
	. /lib/functions.sh
	config_load 'mihomo'

	local enabled data_dir controller_port ui_path secret
	config_get_bool enabled 'main' 'enabled' 1
	config_get data_dir 'main' 'data_dir' '/etc/mihomo'
	config_get controller_port 'main' 'controller_port' '9090'
	config_get ui_path 'main' 'ui_path' 'ui'
	config_get secret 'main' 'secret' ''

	[ "${enabled}" = '1' ] || return 1

	if ! ensure_binary "${data_dir}"; then
		echo "mihomo: cannot start without binary at ${data_dir}/mihomo" >&2
		return 1
	fi

	if [ ! -f "${data_dir}/config.yaml" ]; then
		echo "mihomo: config.yaml missing at ${data_dir}/config.yaml" >&2
		return 1
	fi

	generate_runtime_config "${data_dir}" "${controller_port}" "${ui_path}" "${secret}"

	procd_open_instance mihomo
	procd_set_param command "${data_dir}/mihomo" -f "${RUNTIME_CONFIG}" -d "${data_dir}"
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param limits core="unlimited"
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_set_param user root
	procd_set_param pidfile /var/run/mihomo.pid
	procd_set_param file /etc/config/mihomo "${data_dir}/config.yaml"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger 'mihomo'
}
