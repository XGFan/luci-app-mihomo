#!/bin/sh

set -eu

[ -n "${IPKG_INSTROOT:-}" ] && exit 0

action="${1:-}"
initd="/etc/init.d/mihomo"

if [ -x "${initd}" ]; then
  "${initd}" stop >/dev/null 2>&1 || true

  case "${action}" in
    remove|purge|deconfigure)
      "${initd}" disable >/dev/null 2>&1 || true
      ;;
  esac
fi

exit 0
